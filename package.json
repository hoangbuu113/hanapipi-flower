{
  "name": "hanapipi-flower",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "vite --mode worker",
    "build": "vite build",
    "build:staging": "node scripts/staging.js build",
    "deploy:staging": "node scripts/staging.js deploy",
    "postbuild": "node scripts/remove-build-dev-vars.js",
    "db:generate:catalogue-migration": "node --import ./scripts/d1/register-catalogue-loader.js ./scripts/d1/generate-catalogue-migration.js",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:d1": "node --import ./scripts/d1/register-catalogue-loader.js ./scripts/d1/validate-foundation.js",
    "test:admin": "node --import ./test/register-assets.js --test test/admin-dashboard.test.js test/admin-orders.test.js",
    "test:auth": "node --import ./test/register-assets.js --test test/auth-api.test.js",
    "test:catalogue": "node --import ./test/register-assets.js --test test/catalogue-api.test.js",
    "test:flower-finder": "node --import ./test/register-assets.js --test test/flower-finder-catalogue.test.js",
    "test:frontend": "node --import ./test/register-assets.js --test test/frontend-auth.test.js test/admin-dashboard.test.js test/admin-orders.test.js test/shop-catalogue.test.js test/product-detail-catalogue.test.js test/search-catalogue.test.js test/home-catalogue.test.js test/flower-finder-catalogue.test.js test/wishlist-catalogue.test.js test/cart-catalogue.test.js test/order-checkout.test.js test/orders-read.test.js test/order-payment.test.js test/secondary-catalogue.test.js",
    "test:home": "node --import ./test/register-assets.js --test test/home-catalogue.test.js",
    "test:media": "node --import ./test/register-assets.js --test test/media-utils.test.js",
    "test:product-detail": "node --import ./test/register-assets.js --test test/product-detail-catalogue.test.js",
    "test:search": "node --import ./test/register-assets.js --test test/search-catalogue.test.js",
    "test:secondary": "node --import ./test/register-assets.js --test test/secondary-catalogue.test.js",
    "test:shop": "node --import ./test/register-assets.js --test test/shop-catalogue.test.js",
    "test:wishlist": "node --import ./test/register-assets.js --test test/wishlist-catalogue.test.js",
    "test:cart": "node --import ./test/register-assets.js --test test/cart-catalogue.test.js",
    "test:order": "node --import ./test/register-assets.js --test test/order-checkout.test.js test/orders-read.test.js test/order-payment.test.js test/admin-orders.test.js",
    "lint": "oxlint",
    "test:worker": "node --import ./test/register-assets.js --test test/worker-api.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/backend": "3.18.1",
    "@clerk/clerk-react": "^5.61.10",
    "lucide-react": "^1.33.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
