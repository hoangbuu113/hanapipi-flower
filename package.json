{
  "name": "hanapipi-flower",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "vite --mode worker",
    "build": "vite build",
    "postbuild": "node scripts/remove-build-dev-vars.js",
    "db:generate:catalogue-migration": "node --import ./scripts/d1/register-catalogue-loader.js ./scripts/d1/generate-catalogue-migration.js",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:d1": "node --import ./scripts/d1/register-catalogue-loader.js ./scripts/d1/validate-foundation.js",
    "test:auth": "node --import ./test/register-assets.js --test test/auth-api.test.js",
    "test:frontend": "node --import ./test/register-assets.js --test test/frontend-auth.test.js",
    "lint": "oxlint",
    "test:worker": "node --import ./test/register-assets.js --test test/worker-api.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/backend": "3.18.1",
    "@clerk/clerk-react": "^5.61.10",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
